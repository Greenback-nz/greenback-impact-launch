{
  "name": "greenback-hero",
  "version": "1.0.0",
  "private": true,
  "description": "Looping hero animation for greenback.solutions - regenerative agriculture",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render HeroLoop out/hero.mp4",
    "build-webm": "remotion render HeroLoop out/hero.webm --codec=vp9",
    "build-poster": "remotion still HeroLoop out/poster.png --frame=270"
  },
  "dependencies": {
    "@remotion/cli": "4.0.200",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.200"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.4.5"
  }
}
